# Makefile: builds @@builtRom@@ from this project's sources and checks it against @@sha1File@@.
#
#   make            build @@builtRom@@ and compare its SHA-1 with @@sha1File@@ (exit 0 only on a match)
#   make rom        build @@builtRom@@ without the comparison
#   make clean      remove everything the build wrote
#
# romlift init wrote this file once and never overwrites it; `npx romlift scaffold --diff` shows how it differs
# from the template of the romlift version package.json pins. What it builds is generated by `romlift generate`:
# modules.mk (the objects in link order and each C object's compiler and flags), ldscript.txt, symbols.ld,
# asm/ and data/. Never edit those; change romlift.toml and run `npx romlift generate`.
#
# To build one object differently, give it an explicit rule (here or in a file you include): an explicit rule
# for build/src/<module>.o or build/<module>.o wins over the pattern rules below.

NAME     := @@name@@
ROM      := @@builtRom@@
ELF      := $(NAME).elf
MAP      := $(NAME).map
SHA1FILE := @@sha1File@@
BASEROM  := @@romFile@@

PREFIX   ?= arm-none-eabi-
AS       := $(PREFIX)as
LD       := $(PREFIX)ld
OBJCOPY  := $(PREFIX)objcopy
HOSTCC   ?= cc

# The assembler arguments of every unit (romlift's dialect); `-I .` resolves the .include and .incbin paths.
ASFLAGS  := -mcpu=arm7tdmi -I .
# The host C preprocessor a C unit goes through before its compiler (mk/<compiler>.mk).
CPPFLAGS := -E -x c -nostdinc -undef -I include

# sha1sum on Linux (and recent macOS), shasum -a 1 elsewhere; both read @@sha1File@@'s `<sha1>  <file>` format.
SHA1SUM  := $(shell command -v sha1sum >/dev/null 2>&1 && echo sha1sum || echo 'shasum -a 1')

.DEFAULT_GOAL := compare
.PHONY: all compare rom clean
.SUFFIXES:

all: compare

# OBJS (every object in link order), C_OBJS (the C objects) and, per C object, CC1 and CFLAGS.
ifneq ($(wildcard modules.mk),)
include modules.mk
else ifeq ($(filter clean,$(MAKECMDGOALS)),)
$(error modules.mk is missing: run ./setup.sh, or npx romlift generate)
endif

# One fragment per C compiler: mk/<id>.mk defines C_RECIPE_<id>, the recipe of a C object whose CC1 is
# tools/agbcc/bin/<id>.
include $(sort $(wildcard mk/*.mk))

compare: $(ROM)
	$(SHA1SUM) -c $(SHA1FILE)

rom: $(ROM)

$(ROM): $(ELF)
	$(OBJCOPY) -O binary $< $@

# ldscript.txt places every object in link order and INCLUDEs symbols.ld when it defines a symbol.
$(ELF): $(OBJS) ldscript.txt symbols.ld
	$(LD) -T ldscript.txt -Map $(MAP) -o $@ $(OBJS)

# An asm unit (asm/<module>.s, or asm/rom_header.s and asm/crt0.s) and a data unit (data/<module>.s).
build/%.o: asm/%.s
	@mkdir -p $(@D)
	$(AS) $(ASFLAGS) --MD $(@:.o=.d) -o $@ $<

build/%.o: data/%.s
	@mkdir -p $(@D)
	$(AS) $(ASFLAGS) --MD $(@:.o=.d) -o $@ $<

# A C unit: src/<module>.c through the recipe of its compiler's fragment. Each C object records beside it
# (build/src/<module>.sum) the SHA-1 of its source and of modules.mk (its compiler and flags); an object whose
# record differs from them now is removed, with the ELF, before make decides what to rebuild. Make compares
# modification times, GNU make 3.81 (macOS) only to the second, so a source or a compiler changed within the second
# of the last build, or a modules.mk that `romlift generate` rewrote, would otherwise leave the old object in the ROM.
C_SUM = cat $(1) modules.mk 2>/dev/null | $(SHA1SUM) | cut -d ' ' -f 1
C_STALE := $(strip $(foreach o,$(C_OBJS),$(if $(filter $(shell $(call C_SUM,$(o:build/%.o=%.c))),$(shell cat $(o:.o=.sum) 2>/dev/null)),,$(o))))
ifneq ($(C_STALE),)
C_REMOVED := $(shell rm -f $(C_STALE) $(ELF))
endif

build/src/%.o: src/%.c
	@mkdir -p $(@D)
	$(if $(value C_RECIPE_$(notdir $(CC1))),,$(error $@: no mk/$(notdir $(CC1)).mk defines C_RECIPE_$(notdir $(CC1)) (CC1 is '$(CC1)')))
	$(C_RECIPE_$(notdir $(CC1)))
	$(call C_SUM,$<) > $(@:.o=.sum)

# A file an old dependency list names but `romlift generate` removed: nothing to remake, and the unit that
# still includes it fails in the assembler. An intermediate .s of a C unit is rewritten by its unit's recipe.
asm/nonmatchings/%.s: ;
build/src/%.s: ;

-include $(OBJS:.o=.d) $(C_OBJS:.o=.c.d)

clean:
	rm -rf build $(ROM) $(ELF) $(MAP)
