{
  "name": "romlift",
  "version": "0.0.0",
  "private": true,
  "description": "Turns a GBA ROM into a matching-decompilation project that rebuilds it byte for byte",
  "license": "MIT",
  "author": "Bruno Macabeus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macabeus/romlift.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "bin": {
    "romlift": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./internal": {
      "source": "./src/internal.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist/",
    "templates/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --conditions=source --test \"test/*.test.ts\" \"test/{unit,golden,mutation}/**/*.test.ts\"",
    "test:local": "node --conditions=source --test \"test/local/**/*.test.ts\"",
    "bench": "node --conditions=source bench/src/cli.ts",
    "corpus": "node --conditions=source test/corpus/generate.ts",
    "export-poc": "node --conditions=source bench/tools/export-poc.ts",
    "agbcc": "node --conditions=source bench/tools/agbcc.ts",
    "fixtures": "node --conditions=source bench/tools/fixtures.ts",
    "signatures": "node --conditions=source bench/tools/signatures.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@match-kit/decomp-yaml": "^0.1.0",
    "@match-kit/isa": "0.1.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "~24.7.0",
    "@typescript-eslint/utils": "8.72.1",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
