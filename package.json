{
  "name": "romlift",
  "version": "0.0.0",
  "private": true,
  "description": "Turns a GBA ROM into a matching-decompilation project that rebuilds it byte for byte",
  "license": "MIT",
  "author": "Bruno Macabeus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macabeus/romlift.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "romlift": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./isa": {
      "source": "./src/isa.ts",
      "default": "./dist/isa.js"
    },
    "./internal": {
      "source": "./src/internal.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist/",
    "templates/",
    "signatures/specs/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=source --test \"test/*.test.ts\" \"test/{unit,golden,mutation}/**/*.test.ts\"",
    "test:local": "node --conditions=source --test \"test/local/**/*.test.ts\"",
    "bench": "node --conditions=source bench/src/cli.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "~22.18.0",
    "typescript": "~6.0.3"
  }
}
